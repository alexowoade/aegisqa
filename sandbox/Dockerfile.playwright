FROM python:3.12-slim
RUN groupadd -g 10001 sandbox && useradd -u 10001 -g sandbox -m -s /bin/false sandbox
# Browsers must live outside the installer's home: the container runs as
# user 10001 (home /home/sandbox), but the image build runs as root.
# PLAYWRIGHT_BROWSERS_PATH points both at the same shared, world-readable dir.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pip install --no-cache-dir playwright && playwright install --with-deps chromium && chmod -R a+rX /ms-playwright
WORKDIR /workspace
USER 10001:10001
